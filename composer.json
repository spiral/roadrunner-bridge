{
    "name": "spiral/roadrunner-bridge",
    "type": "library",
    "description": "RoadRunner integration package",
    "license": "MIT",
    "homepage": "https://spiral.dev",
    "support": {
        "issues": "https://github.com/spiral/roadrunner-bridge/issues",
        "source": "https://github.com/spiral/roadrunner-bridge",
        "docs": "https://spiral.dev/docs",
        "chat": "https://discord.gg/V6EK4he"
    },
    "authors": [
        {
            "name": "Anton Titov (wolfy-j)",
            "email": "wolfy-j@spiralscout.com"
        },
        {
            "name": "Pavel Butchnev (butschster)",
            "email": "pavel.buchnev@spiralscout.com"
        },
        {
            "name": "Aleksei Gagarin (roxblnfk)",
            "email": "alexey.gagarin@spiralscout.com"
        },
        {
            "name": "Maksim Smakouz (msmakouz)",
            "email": "maksim.smakouz@spiralscout.com"
        }
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/spiral"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/http-factory": "^1.1",
        "roadrunner/app-logger": "^1.3",
        "roadrunner/centrifugo": "^2.5",
        "roadrunner/grpc": "^3.8",
        "roadrunner/http": "^4.2",
        "roadrunner/jobs": "^4.9",
        "roadrunner/kv": "^4.5",
        "roadrunner/lock": "^1.2",
        "roadrunner/metrics": "^3.4",
        "roadrunner/roadrunner": "^3.0",
        "spiral/boot": "^3.14",
        "spiral/grpc-client": "^1.0",
        "spiral/hmvc": "^3.14",
        "spiral/scaffolder": "^3.13",
        "spiral/serializer": "^3.13"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "buggregator/trap": "^1.16",
        "internal/dload": "^1.15",
        "llm/skills": "^1.11",
        "mockery/mockery": "^1.6.12",
        "roxblnfk/unpoly": "^1.8",
        "spiral/framework": "^3.15.6",
        "spiral/nyholm-bridge": "^1.3",
        "spiral/testing": "4.x-dev",
        "testo/testo": "^0.10.55"
    },
    "conflict": {
        "monolog/monolog": "<3.0"
    },
    "suggest": {
        "ext-protobuf": "For better performance, install the protobuf C extension."
    },
    "autoload": {
        "psr-4": {
            "Spiral\\RoadRunnerBridge\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GPBMetadata\\": "tests/generated/GPBMetadata",
            "Service\\": "tests/generated/Service",
            "Spiral\\App\\": "tests/app",
            "Spiral\\Tests\\": "tests/src"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "dload get --no-interaction"
        ],
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff --config=tools/code-style/.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix -v --config=tools/code-style/.php-cs-fixer.dist.php",
        "test": "vendor/bin/testo",
        "psalm": "psalm -c tools/psalm/psalm.xml",
        "psalm:baseline": "psalm -c tools/psalm/psalm.xml --set-baseline=tools/psalm/psalm-baseline.xml",
        "psalm:ci": "psalm -c tools/psalm/psalm.xml --output-format=github --shepherd --show-info=false --stats --threads=4",
        "structarmed": "structarmed analyze --config=tools/structarmed/structarmed.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "llm/skills": true,
            "spiral/composer-publish-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false,
            "target-directory": "tools"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
